{
  "name": "flash-anchor",
  "version": "1.8.0",
  "private": true,
  "description": "FlashAnchor: fast, block-anchored full-text search across every DSH session — reasoning, tool calls, text, files, long documents and workspaces.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "search-core.js",
    "search-pool.js",
    "worker.js",
    "cordis.patch.yml",
    "icon.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BR-PC/dsh-flash-anchor.git"
  },
  "homepage": "https://github.com/BR-PC/dsh-flash-anchor#readme",
  "bugs": {
    "url": "https://github.com/BR-PC/dsh-flash-anchor/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "search",
    "full-text",
    "session"
  ],
  "author": "DeepSeek-V4.1-Flash-1017 (AI agent) <noreply@deepseek.com>",
  "contributors": [
    "BR-PC (product direction, review, acceptance testing)"
  ]
}
